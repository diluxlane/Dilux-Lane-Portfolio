---
import siteData from '../data/site.json';
import LogoFull from './icons/LogoFull.astro';

const { social, copyright } = siteData;
---

<footer class="py-10 md:py-12 border-t border-[var(--color-border)]">
  <div class="max-w-[1440px] mx-auto px-6 md:px-12 lg:px-20">
    <div class="flex flex-col items-center justify-center gap-6">
      <!-- Logo with character reveal -->
      <div class="text-center" data-reveal="fade-up">
        <div class="footer-logo flex items-center justify-center gap-2.5 mb-2 text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors duration-300" id="footer-brand">
          <LogoFull size={24} color="currentColor" />
        </div>
      </div>

      <!-- Social Links -->
      <div class="flex items-center gap-3" data-reveal="fade-up" style="transition-delay: 100ms;">
        {social.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer"
            class="social-icon w-10 h-10 rounded-full border border-[var(--color-border-light)] bg-[var(--color-bg-secondary)]/50 flex items-center justify-center text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-all duration-300"
            aria-label={link.name}>
            {link.icon === 'instagram' && <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>}
            {link.icon === 'tiktok' && <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 3v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M15 3c0 2.5 2 4.5 4.5 4.5"/></svg>}
            {link.icon === 'youtube' && <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9v6l5-3z" fill="currentColor" stroke="none"/></svg>}
          </a>
        ))}
      </div>

      <!-- Copyright -->
      <p class="text-[var(--color-text-muted)] text-xs" data-reveal="fade-up" style="transition-delay: 200ms;">
        {copyright}
      </p>
    </div>
  </div>
</footer>

<style>
  .social-icon {
  }

  .social-icon:hover {
    transform: scale(1.15) rotate(-5deg);
  }
</style>
