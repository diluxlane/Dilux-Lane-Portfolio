---
import site from '../../data/site.json';
interface Props { size?: number | string; color?: string; class?: string; }
const { size = 24, color = 'currentColor', class: className = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 ${className}`} style={`color:${color}`}>
  <svg width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <circle cx="32" cy="32" r="28" stroke="currentColor" stroke-width="1.5" opacity="0.2" stroke-linecap="round" stroke-linejoin="round" />
    <line x1="32" y1="4" x2="32" y2="7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    <line x1="32" y1="57" x2="32" y2="60" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    <line x1="4" y1="32" x2="7" y2="32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    <line x1="57" y1="32" x2="60" y2="32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    <line x1="22" y1="20" x2="22" y2="44" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <line x1="22" y1="20" x2="32" y2="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    <path d="M32 20 C38.5 20 42 25 42 32" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M42 32 C42 39 38 44 32 44 H22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="font-display text-base tracking-[0.15em] whitespace-nowrap">{site.name.toUpperCase()}</span>
</span>
